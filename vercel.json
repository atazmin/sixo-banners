{
    "routes": [
      {
        "src": "/out/[^.]+",
        "dest": "/out/",
        "status": 200,
        "has": [
          {
            "type": "header",
            "key": "authorization",
            "value": "Basic NGFkbWluOlB3ZDEyMw=="
          }
        ]
      },
      {
        "src": "/out/.*",
        "dest": "/out/401",
        "status": 401,
        "headers": { "www-authenticate": "Basic realm=\"staging\"" },
        "missing": [
          {
            "type": "header",
            "key": "authorization",
            "value": "Basic NGFkbWluOlB3ZDEyMw=="
          }
        ]
      }
    ]
  }
  